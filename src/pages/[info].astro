---
import Base from '../layouts/Base.astro';
export function getStaticPaths(){return ['about','contact','privacy'].map(info=>({params:{info}}))}
const target=Astro.params.info;
---
<Base title="Information"><h1>Information</h1><div class="prose"><p>新しい言語別ページをご利用ください。</p><a href={`/ja/${target}/`}>日本語 →</a><p><a href={`/en/${target}/`}>English →</a> · <a href={`/zh-tw/${target}/`}>繁體中文 →</a></p></div></Base>
