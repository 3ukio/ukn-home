---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import {locales,languageNames} from '../config/site';
const lines={ja:['日本語','グローバル版の、確かな情報を。','サイトへ進む'],en:['English','A clearer view of AION2 Global.','Continue in English'],'zh-tw':['繁體中文','讓國際服資訊，更清楚。','進入網站']};
---
<SiteLayout lang="en" title="Choose your language" description="Independent AION2 Global news and guides in Japanese, English and Traditional Chinese."><section class="container language-landing"><div class="landing-symbol"><Icon name="globe" size={29}/></div><div class="overline">GLOBAL EDITION · STEAM / PURPLE</div><h1>One world. Your language.</h1><p>日本語・English・繁體中文</p><div class="language-choices">{locales.map(lang=><a href={`/${lang}/`} lang={lang==='zh-tw'?'zh-TW':lang}><span class="language-code">{lang==='zh-tw'?'繁':lang.toUpperCase()}</span><strong>{languageNames[lang]}</strong><small>{lines[lang][2]}<Icon size={16}/></small></a>)}</div><p class="landing-note">Choose freely. We never redirect based on your IP address.</p></section></SiteLayout>
