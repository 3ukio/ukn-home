---
import '../styles/v2.css';
import {site,locales,languageNames,htmlLanguages,sections,type Locale} from '../config/site';
import {t} from '../i18n/ui';
import Icon from '../components/Icon.astro';
import MascotSlot from '../components/MascotSlot.astro';
const {lang='ja',title,description,alternates=locales.map(l=>({lang:l,path:`/${l}/`})),noindex=false,articleJson,isArticle=false,section=''}=Astro.props;
const l=lang as Locale,u=t(l);const canonical=new URL(Astro.url.pathname,site.origin).href;
const fallbackText={ja:'翻訳準備中 · カテゴリーへ',en:'Not translated · category','zh-tw':'尚未翻譯 · 前往分類'};
---
<!doctype html><html lang={htmlLanguages[l]} data-theme="light"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="color-scheme" content="light dark"/><title>{title ? `${title} | ${site.name}` : site.name}</title><meta name="description" content={description||u.tagline}/><link rel="canonical" href={canonical}/>{alternates.map(a=><link rel="alternate" hreflang={htmlLanguages[a.lang]} href={new URL(a.path,site.origin).href}/>)}<link rel="alternate" hreflang="x-default" href={site.origin+'/'}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:title" content={title?`${title} | ${site.name}`:site.name}/><meta property="og:description" content={description||u.tagline}/><meta property="og:url" content={canonical}/><meta property="og:type" content={isArticle?'article':'website'}/><meta property="og:site_name" content={site.name}/><meta property="og:locale" content={l==='ja'?'ja_JP':l==='en'?'en_US':'zh_TW'}/><link rel="icon" href="/v2-icon.svg"/>{articleJson&&<script type="application/ld+json" set:html={JSON.stringify(articleJson).replace(/</g,'\u003c')}/>}
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('aion2-theme')==='dark'?'dark':'light'}catch{}</script></head><body><a class="skip-link" href="#main">{u.skip}</a><header class="site-header"><div class="header-inner"><a class="brand-v2" href={`/${l}/`}><span class="brand-symbol" aria-hidden="true"><svg width="25" height="30" viewBox="0 0 25 30" fill="none"><path d="m12.5 2 10 23-10-6L2.5 25l10-23Z" stroke="currentColor" stroke-width="1.8"/><path d="M12.5 11v8" stroke="currentColor"/></svg></span><span>{site.name}<small>INDEPENDENT JOURNAL</small></span></a><nav class="desktop-nav" aria-label={u.menu}>{sections.map(s=><a href={`/${l}/${s}/`} aria-current={section===s?'page':undefined}>{u.nav[s]}</a>)}</nav><div class="header-actions"><details class="language-menu"><summary aria-label={u.language}><Icon name="globe" size={17}/><span>{l==='ja'?'JA':l==='en'?'EN':'繁'}</span><span class="chevron">⌄</span></summary><div class="language-options">{locales.map(target=>{const a=alternates.find(a=>a.lang===target);return <a href={a?.path||`/${target}/${section||'guides'}/?translation=missing`} lang={htmlLanguages[target]} hreflang={htmlLanguages[target]} aria-current={target===l?'true':undefined}>{languageNames[target]}<small>{!a?fallbackText[target]:target===l?'✓':''}</small></a>})}</div></details><button class="theme-button" id="theme-toggle" aria-label={u.theme} aria-pressed="false" type="button"><Icon name="sun" size={19}/></button></div><details class="mobile-menu"><summary>{u.menu} <span>☰</span></summary><nav aria-label={u.menu}>{sections.map(s=><a href={`/${l}/${s}/`} aria-current={section===s?'page':undefined}>{u.nav[s]}</a>)}</nav></details></div></header><main id="main"><div class="container translation-alert" hidden id="translation-alert" role="status">{u.noTranslation}</div><slot/></main><footer class="site-footer"><div class="container footer-main"><div><a class="footer-brand" href={`/${l}/`}>{site.name}<span>INDEPENDENT JOURNAL</span></a><p>{u.independent}</p></div><nav aria-label={u.about}><a href={`/${l}/about/`}>{u.about}</a><a href={`/${l}/contact/`}>{u.contact}</a><a href={`/${l}/privacy/`}>{u.privacy}</a></nav></div><div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} {site.name}</span><span>{u.footerNote}</span><a href="/">日本語 / English / 繁體中文</a></div></footer>{site.mascotEnabled&&<MascotSlot enabled={false}/>}<script>
const toggle=document.querySelector<HTMLButtonElement>('#theme-toggle');
function syncThemeButton(){toggle?.setAttribute('aria-pressed',String(document.documentElement.dataset.theme==='dark'));}
syncThemeButton();toggle?.addEventListener('click',()=>{const value=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=value;try{localStorage.setItem('aion2-theme',value)}catch{}syncThemeButton()});
if(new URLSearchParams(location.search).get('translation')==='missing')document.querySelector<HTMLElement>('#translation-alert')!.hidden=false;
document.addEventListener('click',e=>{document.querySelectorAll<HTMLDetailsElement>('.language-menu[open]').forEach(d=>{if(!d.contains(e.target as Node))d.open=false})});
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll<HTMLDetailsElement>('details[open]').forEach(d=>d.open=false)});
</script></body></html>
