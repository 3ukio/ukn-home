---
import {render} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import Sidebar from '../../components/Sidebar.astro';
import Icon from '../../components/Icon.astro';
import {site,locales,sections,infoPages,type Locale} from '../../config/site';
import {t} from '../../i18n/ui';
import {publishedArticles,articlePath,inSection,translatedArticle,type Article} from '../../lib/content';
import {noticeText} from '../../i18n/notices';
import {articlePublishedAt} from '../../lib/content';
import {formatDate,maintenanceTime} from '../../lib/dates';
export async function getStaticPaths(){
 const all=await publishedArticles();
 return locales.flatMap(lang=>[
  {params:{lang,route:undefined},props:{mode:'home',all}},
  ...[...sections,...infoPages].map(route=>({params:{lang,route},props:{mode:route,all}})),
  ...all.filter(a=>a.data.lang===lang).map(article=>({params:{lang,route:`articles/${article.data.slug}`},props:{mode:'article',all,article}})),
 ]);
}
const {mode,all,article}=Astro.props as {mode:string,all:Article[],article?:Article};
const lang=Astro.params.lang as Locale,u=t(lang),n=noticeText(lang),items=all.filter(a=>a.data.lang===lang);
const titles={home:n.homeTitle,news:u.newsTitle,maintenance:u.maintenanceTitle,operations:u.operationsTitle,guides:u.guidesTitle,tools:u.toolsTitle,about:u.about,contact:u.contact,privacy:u.privacy};
const descriptions={home:n.homeDescription,news:u.newsDesc,maintenance:u.maintenanceDesc,operations:u.operationsDesc,guides:u.guidesDesc,tools:u.toolsDesc,about:u.aboutBody,contact:u.contactBody,privacy:u.privacyBody};
const title=article?.data.title||titles[mode],description=article?.data.summary||descriptions[mode];
const section=article?(article.data.category==='guide'?'guides':article.data.category==='maintenance'?'maintenance':article.data.category==='enforcement'?'operations':'news'):mode;
const alternates=article?locales.flatMap(l=>{const a=translatedArticle(all,article.data.translationKey,l);return a?[{lang:l,path:articlePath(a)}]:[]}):locales.map(l=>({lang:l,path:`/${l}/${mode==='home'?'':mode+'/'}`}));
const rendered=article?await render(article):null;const Content=rendered?.Content;
// Omit Article JSON-LD until a real author and all relevant publication fields exist.
const articleJson=article?.data.author&&article.data.officialPublishedAt?{'@context':'https://schema.org','@type':'Article',headline:article.data.title,description:article.data.summary,datePublished:article.data.publishedAt,dateModified:article.data.updatedAt,inLanguage:lang==='zh-tw'?'zh-TW':lang,author:{'@type':'Person',name:article.data.author},mainEntityOfPage:new URL(articlePath(article),site.origin).href,...(article.data.image?{image:new URL(article.data.image.src,site.origin).href}:{})}:undefined;
const notices=items.filter(a=>a.data.category!=='guide');
const guides=items.filter(a=>a.data.category==='guide');
const maintenance=items.filter(a=>a.data.category==='maintenance');
const currentMaintenance=maintenance[0]?.data.maintenance;
---
<SiteLayout {lang} {title} {description} {alternates} {section} {articleJson} isArticle={mode==='article'}>
{mode==='home'?<>
 <section class="notice-banner"><div class="container"><div><h1>{n.homeTitle}</h1><p>{n.homeDescription}</p></div><span class="banner-edition">GLOBAL · STEAM / PURPLE</span></div></section>
 <section class="container content-columns home-columns"><div class="content-primary"><div class="section-heading"><h2>{n.latest}</h2><span class="small-muted">{u.manual}</span></div><nav class="notice-tabs" aria-label={u.categories}><a aria-current="page" href={`/${lang}/`}>{n.latest}</a><a href={`/${lang}/news/`}>{u.nav.news}</a><a href={`/${lang}/maintenance/`}>{u.nav.maintenance}</a><a href={`/${lang}/operations/`}>{u.nav.operations}</a></nav><ArticleList articles={notices} {lang} officialOnly={true}/><div class="publication-note"><Icon name="shield" size={18}/><p>{n.sourceNote} {u.sourceHint}</p></div><section class="guide-preview"><div class="section-heading"><h2>{n.guides}</h2><a class="text-link" href={`/${lang}/guides/`}>{n.all}<Icon size={17}/></a></div><ArticleList articles={guides.slice(0,3)} {lang}/></section><nav class="utility-links" aria-label={u.quick}><a href={`/${lang}/guides/`}><Icon name="book" size={19}/>{u.nav.guides}<Icon size={17}/></a><a href={`/${lang}/tools/`}><Icon name="tools" size={19}/>{u.nav.tools}<span>{u.planned}</span><Icon size={17}/></a></nav></div><Sidebar {lang} articles={items}/></section>
 </>:mode==='article'&&article&&Content?<>
 <div class="container breadcrumb"><a href={`/${lang}/`}>{u.home}</a><span>/</span><a href={`/${lang}/${section}/`}>{u.nav[section]}</a><span>/</span><span>{u.types[article.data.category]}</span></div><div class="container article-columns"><div><header class="article-header"><div class="row-meta"><span class="badge">{u.types[article.data.category]}</span><span>{article.data.edition} · {article.data.platforms.join(' / ')}</span></div><h1>{article.data.title}</h1><dl class="notice-detail-meta"><div><dt>{article.data.category==='guide'?n.guideDate:n.published}</dt><dd><time datetime={articlePublishedAt(article)} title={formatDate(articlePublishedAt(article),lang)}>{formatDate(articlePublishedAt(article),lang)}</time></dd></div><div><dt>{n.region}</dt><dd>{article.data.region}</dd></div><div><dt>{n.source}</dt><dd><a href={article.data.sourceUrl} target="_blank" rel="noopener noreferrer">{new URL(article.data.sourceUrl).hostname==='store.steampowered.com'?'Steam':'NC / AION2'}<Icon name="external" size={15}/></a></dd></div><div><dt>{n.updated}</dt><dd><time datetime={article.data.updatedAt}>{formatDate(article.data.updatedAt,lang)}</time></dd></div><div><dt>{n.verified}</dt><dd><time datetime={article.data.verifiedAt}>{formatDate(article.data.verifiedAt,lang)}</time></dd></div></dl><div class="article-notice-banner"><span>{article.data.category==='guide'?n.detailGuideBand:n.detailBand}</span><span>{article.data.region}</span></div><p class="article-summary">{article.data.summary}</p></header>{article.data.category==='guide'&&<div class="editorial-note"><Icon name="book" size={19}/><p>{u.editorNote}</p></div>}{article.data.image&&<figure class="article-figure"><img src={article.data.image.src} alt={article.data.image.alt} width={article.data.image.width} height={article.data.image.height}/><figcaption>{article.data.image.caption} · <a href={article.data.image.sourceUrl} rel="noopener noreferrer" target="_blank">{u.source}</a></figcaption></figure>}
 {article.data.maintenance&&<section class="record-panel"><h2>{u.maintenanceTitle}</h2><span class="badge">{u.statuses[article.data.maintenance.status]}</span><dl><dt>{u.region}</dt><dd>{article.data.maintenance.region}</dd><dt>{u.start}</dt><dd>{maintenanceTime(article.data.maintenance.startsAt,lang,article.data.maintenance.timeZone)}</dd><dt>{u.expectedEnd}</dt><dd>{maintenanceTime(article.data.maintenance.expectedEndsAt,lang,article.data.maintenance.timeZone)}</dd>{article.data.maintenance.actualEndsAt&&<><dt>{u.actualEnd}</dt><dd>{maintenanceTime(article.data.maintenance.actualEndsAt,lang,article.data.maintenance.timeZone)}</dd></>}</dl><p>{u.noLive}</p>{article.data.maintenance.completionSourceUrl&&<a href={article.data.maintenance.completionSourceUrl} target="_blank" rel="noopener noreferrer">{u.notices} ↗</a>}</section>}
 {article.data.enforcement&&<section class="record-panel"><h2>{u.operationsTitle}</h2><dl><dt>{u.reason}</dt><dd>{article.data.enforcement.reason}</dd><dt>{u.count}</dt><dd>{new Intl.NumberFormat(lang).format(article.data.enforcement.accountRestrictions)}</dd></dl><p>{article.data.enforcement.countingNote}</p><p>{u.countNote}</p></section>}
 <article class="prose"><Content/></article><section class="article-source"><h2>{u.source}</h2><dl><dt>{u.edition}</dt><dd>{article.data.edition} / {article.data.platforms.join(' · ')}</dd><dt>{u.region}</dt><dd>{article.data.region}</dd><dt>{u.officialDate}</dt><dd>{article.data.officialPublishedAt?formatDate(article.data.officialPublishedAt,lang):u.unpublishedDate}</dd><dt>{u.verified}</dt><dd><time datetime={article.data.verifiedAt}>{formatDate(article.data.verifiedAt,lang)}</time></dd></dl><a href={article.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-link">{u.notices}<Icon name="external" size={16}/></a></section><a class="back-link" href={`/${lang}/${section}/`}>← {u.back}</a></div><aside class="article-aside"><div class="toc"><h2>{u.toc}</h2>{rendered.headings.filter(h=>h.depth===2).map((h,i)=><a href={`#${h.slug}`}><span>{String(i+1).padStart(2,'0')}</span>{h.text}</a>)}</div><div class="aside-note"><Icon name="shield" size={21}/><p>{u.manual}</p><small>{u.noLive}</small></div></aside></div>
 </>:infoPages.includes(mode as any)?<section class="container info-page"><div class="overline">INFORMATION</div><h1>{title}</h1><div class="prose"><p>{descriptions[mode]}</p>{mode==='contact'&&site.contactEmail&&<a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}<p>{u.independent}</p><a href={site.official} target="_blank" rel="noopener noreferrer">{u.official} ↗</a></div></section>:<>
 <section class="container page-intro"><div class="overline">GLOBAL JOURNAL <span class="overline-divider">/</span> {mode.toUpperCase()}</div><h1>{title}</h1><p>{description}</p><span class="subtle-chip">{u.scope}</span></section><div class="container content-columns section-columns"><div class="content-primary">
 {mode==='maintenance'&&<div class="maintenance-status"><div class="status-heading"><Icon name="clock" size={22}/><span>{currentMaintenance?u.maintenanceTitle:u.noSchedule}</span><span class="status-pill">{u.statuses[currentMaintenance?.status||'unconfirmed']}</span></div>{currentMaintenance?<dl class="schedule-summary"><dt>{u.region}</dt><dd>{currentMaintenance.region}</dd><dt>{u.start}</dt><dd>{maintenanceTime(currentMaintenance.startsAt,lang,currentMaintenance.timeZone)}</dd><dt>{u.expectedEnd}</dt><dd>{maintenanceTime(currentMaintenance.expectedEndsAt,lang,currentMaintenance.timeZone)}</dd></dl>:<p>{u.noScheduleHint}</p>}<a class="text-link" href={site.notices} target="_blank" rel="noopener noreferrer">{u.notices}<Icon name="external" size={15}/></a></div>}
 {mode==='operations'&&<div class="editorial-note"><Icon name="shield" size={22}/><p>{u.countNote}</p></div>}
 {mode!=='tools'&&<ArticleList articles={items.filter(a=>inSection(a,mode))} {lang}/>}
 {(mode==='guides'||mode==='tools')&&<section class="roadmap"><h2>{u.roadmap}</h2><div class="roadmap-list">{(mode==='guides'?u.roadmapGuides:u.roadmapTools).map((label,i)=><div><span class="roadmap-number">0{i+1}</span><h3>{label}</h3><span class="badge-neutral">{u.planned}</span></div>)}</div><p>{u.notAvailable} {u.futureHint}</p></section>}
 </div><Sidebar {lang} articles={items} active={mode}/></div></>}
</SiteLayout>
